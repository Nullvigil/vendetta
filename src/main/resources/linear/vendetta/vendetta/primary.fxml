<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="700.0" minWidth="1100.0" prefHeight="900.0" prefWidth="1440.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox prefHeight="70.0" prefWidth="1440.0" spacing="12.0" styleClass="top-bar" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Label fx:id="brandTitle" styleClass="brand-title" text="VENDETTA" />
            <Label fx:id="subtitleLabel" text="Linear Algebra Workbench" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label text="JAVA 21" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox prefHeight="780.0" prefWidth="1400.0" spacing="16.0" BorderPane.alignment="TOP_LEFT">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <VBox minWidth="380.0" prefHeight="200.0" prefWidth="420.0" spacing="16.0" styleClass="io-panel" HBox.hgrow="NEVER">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label styleClass="section-title" text="Operations" />
                  <Label styleClass="muted-text" text="Enter your values and select an operation" />
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="8.0">
                     <children>
                        <Label text="Operation" />
                        <ComboBox fx:id="operationComboBox" maxWidth="1.7976931348623157E308" prefHeight="40.0" prefWidth="150.0" promptText="Select operation" styleClass="operation-selector" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" styleClass="lab">
                     <children>
                        <Label text="Matrix A" />
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
                           <children>
                              <Label text="Rows" />
                              <Spinner fx:id="rowsASpinner" prefWidth="85.0" />
                              <Label text="Columns" />
                              <Spinner fx:id="colsASpinner" prefWidth="85.0" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
